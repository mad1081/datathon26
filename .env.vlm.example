# Prefer: python deploy/vllm/serve.py --model Qwen/Qwen3.5-9B --profile eval --write-env .env
# This selects the matching image/revision/TP and generates a random API_KEY.
VLM_MODEL=Qwen/Qwen3.5-9B
VLM_PROFILE=eval
VLM_ENFORCE_EAGER=1
VLM_TP_SIZE=1
VLM_MAX_NUM_SEQS=8
VLM_MAX_MODEL_LEN=65536
VLM_MAX_IMAGES=160
VLM_MAX_VIDEOS=1
VLM_MAX_BATCHED_TOKENS=8192
VLM_GPU_MEMORY_UTILIZATION=0.90
APP_PORT=8000
# Required: set a random secret locally; do not commit .env.
API_KEY=
# final profile: VLM_PROFILE=final and VLM_ENFORCE_EAGER=0 (or unset).
# HF_TOKEN is optional for public repositories.
